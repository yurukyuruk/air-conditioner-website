---
---
<ul class="image-list">
</ul>
<div id="overlay" class="overlay">
    <img id="overlay-image" class="overlay-image" src="" alt="Enlarged Image" />
</div>
<button class="see-more-button">See More</button>

<script>
    document.addEventListener('DOMContentLoaded', () => {
      const allHeatPumpImages = [
        { heatPumpImageSrc: '/images/heat-pump-1.png' },
        { heatPumpImageSrc: '/images/heat-pump-2.png' },
        { heatPumpImageSrc: '/images/heat-pump-3.png' },
        { heatPumpImageSrc: '/images/heat-pump-4.png' },
        { heatPumpImageSrc: '/images/heat-pump-5.png' },
        { heatPumpImageSrc: '/images/heat-pump-6.png' },
        { heatPumpImageSrc: '/images/heat-pump-7.png' },
        { heatPumpImageSrc: '/images/heat-pump-8.png' },
        { heatPumpImageSrc: '/images/heat-pump-9.png' },
        { heatPumpImageSrc: '/images/heat-pump-10.png' },
        { heatPumpImageSrc: '/images/heat-pump-11.png' },
        { heatPumpImageSrc: '/images/heat-pump-12.png' },
        { heatPumpImageSrc: '/images/heat-pump-13.png' },
        { heatPumpImageSrc: '/images/heat-pump-14.png' }
      ];

      const overlay:HTMLDivElement | null = document.querySelector(".overlay");
      overlay?.addEventListener("click", handleOverlayClick);

      function handleOverlayClick() {
        if (overlay) {
          overlay.style.display = 'none';
        }
      }
      const imagesPerLoad = window.innerWidth > 2159 ? 8 : 6; // Check screen width
      let visibleImages = 0;

      function renderImages() {
        const imageList = document.querySelector('.image-list');
        const seeMoreButton: HTMLButtonElement | null= document.querySelector('.see-more-button');
        const nextImages = allHeatPumpImages.slice(visibleImages, visibleImages + imagesPerLoad);
        nextImages.forEach((image, index) => {
          const li = document.createElement('li');
          const img = document.createElement('img');
          const actualIndex = visibleImages + index;
          img.src = image.heatPumpImageSrc;
          img.alt = `Obraz pompy ciepła ${actualIndex + 1}`;
          img.className = 'gallery-image';
          img.dataset.index = actualIndex.toString();
          img.addEventListener('click', () => handleImageClick(actualIndex));
          li.appendChild(img);
          imageList?.appendChild(li);
        });

        visibleImages += imagesPerLoad;

        if (visibleImages >= allHeatPumpImages.length) {
          if (seeMoreButton) {
            seeMoreButton.style.display = 'none';
          }
        }
      }

      function handleImageClick(index: number) {
        const overlayImage = document.getElementById('overlay-image') as HTMLImageElement;
        const image = document.querySelector(`img[data-index="${index}"]`) as HTMLImageElement;

        if (overlayImage && image) {
          overlayImage.src = image.src;
        }
        if (overlay) {
          overlay.style.display = 'flex';
        }
      }


      renderImages();
      const seeMoreButton = document.querySelector('.see-more-button');
      if (seeMoreButton) {
        seeMoreButton.addEventListener('click', renderImages);
      }
      if (overlay) {
        overlay.addEventListener('click', handleOverlayClick);
      }
    });
</script>

<style>
.image-list {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(auto, 310px));
  gap: 30px;
  justify-content: center;
  padding: 10px;
  margin: 20px 0 20px 0;
}
.gallery-image {
  width: 150px;
  height: 150px;
  object-fit: cover;
  cursor: pointer;
  transition: transform 0.2s;
}

.gallery-image:hover {
  transform: scale(1.05);
}
li {
  list-style: none;
  margin: 0;
}
.overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.overlay-image {
  max-width: 90%;
  max-height: 90%;
}

button {
  color: var(--black-text-color);
  background-color: var(--main-background-color);
  text-decoration: none;
  font-size: var(--font-size-l);
  width: 220px;
  border: 2px var(--main-blue-color) solid;
  padding: 10px 20px 10px 20px;
  margin-bottom: 20px;
  text-align: center;
  border-radius: 20px;
  box-shadow: rgba(0, 0, 0, 0.438) 0px 2px 8px;
  transition: transform 0.5s ease-in-out;
  align-self: center;
  margin: 0;
  cursor: pointer;
  margin-bottom: 32px;
}

button:hover,
button:active {
  transform: scale(1.1);
  background-color: var(--main-blue-color);
  color: white;
}

@media (min-width: 1024px) {
  .image-list {
    grid-template-columns: repeat(auto-fill, minmax(auto, 310px));
    max-width: calc(3 * 310px + 2 * 30px);
    gap: 30px;
    justify-content: center;
    padding: 10px;
    margin: 20px 0 20px 0;
  }
}

@media (min-width: 2160px) {
  .image-list {
    max-width: calc(4 * 310px + 3 * 30px);
  }
}
</style>