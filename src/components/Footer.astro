---
import Logo from "./Logo.astro";
---

<section>
    <div class="logo-address-part">
        <Logo></Logo>
        <address>
            <p><span>Address: </span>ul. Biedronkowa 19/40, 91-358 Łódź</p>
            <p><span>Tel: </span> <a href="tel:+48666264999">+48 666 264 999</a></p>
            <p><span>E-mail: </span> <a href="ms.instalbud.lodz@gmail.com">ms.instalbud.lodz@gmail.com</a></p>
        </address>
    </div>
    <div class="copy-right-part">
        <p class="copy-right"><span>Copyright © 2024 <a target="_blank"
                                                        href="https://yurukyuruk.github.io/portfolio/">Asli Yuruk</a></span>
        </p>
    </div>
</section>
<style>
    section {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-family: var(--root-font-family);
        border-top: 1px solid var(--seperator-border-color);
        margin-top: auto;
        padding-top: 18px;
    }

    .copy-right-part {
        width: var(--width-for-desktop);
    }

    .logo-address-part {
        width: var(--width-for-desktop);
        justify-content: flex-start;
    }

    address {
        padding-bottom: 28px;
        font-size: var(--font-size-s);
        font-style: normal;
    }

    .address p {
        margin: 0;
        padding-bottom: 4px;
    }

    span {
        font-weight: bold;
    }

    a {
        text-decoration: none;
        color: black;
    }

    .copy-right {
        font-size: var(--font-size-xs);
        margin: 0;
        padding-bottom: 8px;
    }

    @media (max-width: 1024px) {
        .copy-right-part, .logo-address-part {
            width: var(--width-for-mobile);
        }
    }
</style>
